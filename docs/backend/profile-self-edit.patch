+        return client.put().uri("/user/me").headers(headers -> headers.setBearerAuth((String) login.get("access_token")))
+                .contentType(MediaType.APPLICATION_JSON).bodyValue(body).exchange();
+    }
+
+    private UserEntity reloadActor() {
+        return users.findById(actor.getId()).orElseThrow();
+    }
+
+    private UserEntity createUser(final String name, final String phone) {
+        RoleEntity role = roles.findByName(name).orElseGet(() -> {
+            RoleEntity fresh = new RoleEntity();
+            fresh.setExternalKey(UUID.randomUUID());
+            fresh.setName(name);
+            fresh.setLevel("TECH_ADMIN".equals(name) ? 100 : "ADMIN".equals(name) ? 80 : 10);
+            if (Set.of("ADMIN", "DIRECTOR", "TECH_ADMIN").contains(name)) {
+                PermissionEntity write = permissions.findAll().stream().filter(p -> "USER_WRITE".equals(p.getName()))
+                        .findFirst().orElseGet(() -> {
+                            PermissionEntity permission = new PermissionEntity();
+                            permission.setName("USER_WRITE");
+                            return permissions.save(permission);
+                        });
+                fresh.setPermissions(Set.of(write));
+            }
+            return roles.save(fresh);
+        });
+        OrganizationEntity organization = null;
+        if (!"TECH_ADMIN".equals(name)) {
+            organization = new OrganizationEntity();
+            organization.setExternalKey(UUID.randomUUID());
+            organization.setName("Синтетический сад");
+            organization.setTimeZone("Europe/Moscow");
+            organization.setStatus(EntityStatus.ACTIVE);
+            organization = organizations.save(organization);
+        }
+        UserEntity user = new UserEntity();
+        user.setExternalKey(UUID.randomUUID());
+        user.setEmail(UUID.randomUUID() + "@example.test");
+        user.setSurname("Исходная");
+        user.setFirstName("Анна");
+        user.setBirthDate(LocalDate.of(1988, 5, 12));
+        user.setGender(Gender.FEMALE);
+        user.setPhone(phone);
+        user.setPassword(encoder.encode(PASSWORD));
+        user.setStatus("ACTIVE");
+        user.setRole(role);
+        user.setOrganization(organization);
+        return users.save(user);
+    }
