+import ru.dobrocode.visit.control.entity.RoleEntity;
+import ru.dobrocode.visit.control.entity.UserEntity;
+import ru.dobrocode.visit.control.enums.EntityStatus;
+import ru.dobrocode.visit.control.enums.Gender;
+import ru.dobrocode.visit.control.enums.Permission;
+import ru.dobrocode.visit.control.repository.OrganizationRepository;
+import ru.dobrocode.visit.control.repository.PermissionRepository;
+import ru.dobrocode.visit.control.repository.RoleRepository;
+import ru.dobrocode.visit.control.repository.UserRepository;
+
+import java.time.LocalDate;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+
+/** Test classpath only: real local API, synthetic accounts, no production database or outgoing mail. */
+public final class ProfilePreviewLauncher {
+    private ProfilePreviewLauncher() {
+    }
+
+    public static void main(final String[] args) {
+        SpringApplication app = new SpringApplication(VisitControlApplication.class);
+        ConfigurableApplicationContext context = app.run(
+                "--spring.profiles.active=test", "--server.address=127.0.0.1", "--server.port=5221",
+                "--spring.datasource.url=jdbc:h2:mem:profile-preview;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;NON_KEYWORDS=USER,VALUE;DB_CLOSE_DELAY=-1",
+                "--spring.datasource.username=sa", "--spring.datasource.password=",
+                "--spring.datasource.driverClassName=org.h2.Driver",
+                "--spring.jpa.database-platform=org.hibernate.dialect.H2Dialect",
+                "--spring.jpa.hibernate.ddl-auto=create-drop", "--spring.jpa.properties.hibernate.default_schema=public",
+                "--spring.jpa.show-sql=false", "--spring.liquibase.enabled=false",
+                "--auth.user.enabled=true", "--auth.user.tokenLivingTimeoutMs=3600000",
+                "--auth.user.secretKey=synthetic-preview-only-signing-key-000000000000000000",
+                "--visit.test-user.enabled=false", "--email.enabled=false",
+                "--management.health.mail.enabled=false", "--logging.level.root=ERROR");
+        PermissionRepository permissions = context.getBean(PermissionRepository.class);
+        Map<String, PermissionEntity> allPermissions = new HashMap<>();
+        Arrays.stream(Permission.values()).forEach(value -> {
+            PermissionEntity permission = new PermissionEntity();
+            permission.setName(value.name());
+            allPermissions.put(value.name(), permissions.save(permission));
+        });
+        OrganizationEntity garden = new OrganizationEntity();
+        garden.setExternalKey(UUID.randomUUID());
+        garden.setName("Демонстрационный сад");
+        garden.setTimeZone("Europe/Moscow");
+        garden.setStatus(EntityStatus.ACTIVE);
+        garden = context.getBean(OrganizationRepository.class).save(garden);
+        Map<String, Integer> levels = Map.of("PARENT", 10, "EMPLOYEE", 50, "ADMIN", 80,
+                "DIRECTOR", 90, "TECH_ADMIN", 100);
+        for (String name : new String[]{"PARENT", "EMPLOYEE", "ADMIN", "DIRECTOR", "TECH_ADMIN"}) {
+            RoleEntity role = new RoleEntity();
+            role.setExternalKey(UUID.randomUUID());
+            role.setName(name);
+            role.setLevel(levels.get(name));
+            Set<String> allowed = Set.of("USER_READ", "VISIT_READ", "VISIT_WRITE", "GROUP_READ", "BRANCH_READ",
+                    "CHILD_REPRESENTATIVE_READ", "CHILD_REPRESENTATIVE_WRITE");
+            if (Set.of("ADMIN", "DIRECTOR", "TECH_ADMIN").contains(name)) {
+                allowed = allPermissions.keySet();
+            } else if ("EMPLOYEE".equals(name)) {
+                allowed = new HashSet<>(allowed);
+                allowed.add("VISIT_CONFIRM");
+                allowed.add("PRESENCE_READ");
+            }
+            Set<PermissionEntity> grants = new HashSet<>();
+            allowed.forEach(permission -> grants.add(allPermissions.get(permission)));
+            role.setPermissions(grants);
+            role = context.getBean(RoleRepository.class).save(role);
+            UserEntity user = new UserEntity();
+            user.setExternalKey(UUID.randomUUID());
+            user.setEmail(name.toLowerCase(java.util.Locale.ROOT) + "@example.test");
+            user.setSurname("Демо");
+            user.setFirstName("Анна");
+            user.setBirthDate(LocalDate.of(1990, 3, 14));
+            user.setGender(Gender.FEMALE);
+            user.setRole(role);
+            user.setStatus("ACTIVE");
+            user.setOrganization("TECH_ADMIN".equals(name) ? null : garden);
+            user.setPassword(context.getBean(PasswordEncoder.class).encode("synthetic-preview-password"));
+            context.getBean(UserRepository.class).save(user);
+        }
+        System.out.println("Synthetic preview ready on 127.0.0.1:5221; test classpath only");
+    }
+}
