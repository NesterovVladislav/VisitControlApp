{
  "expo": {
    "name": "ДоброВход",
    "slug": "VisitControlApp",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "visitcontrolapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#007AFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dobrocode.visitcontrolapp"
    },
    "web": {
      "output": "single",
      "lang": "ru",
      "name": "ДоброВход",
      "shortName": "ДоброВход",
      "backgroundColor": "#f5f5f5",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите приложению «ДоброВход» доступ к фотографиям, чтобы выбрать фотографию для профиля",
          "cameraPermission": "Разрешите приложению «ДоброВход» использовать камеру, чтобы сканировать QR-код родителя и сделать фотографию для профиля",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите приложению «ДоброВход» использовать камеру, чтобы сканировать QR-код родителя",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Разрешите приложению «ДоброВход» использовать Face ID для входа в приложение"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "./assets/images/icon.png"
  }
}
