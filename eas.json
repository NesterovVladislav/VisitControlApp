{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://core.dobrovhod.ru/api",
        "EXPO_PUBLIC_ALLOW_SCREENSHOTS": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://core.dobrovhod.ru/api"
      }
    }
  }
}
